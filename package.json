{
  "name": "gitlane",
  "productName": "Gitlane",
  "version": "0.0.0",
  "description": "A fast, open-source Git client with a readable commit graph, line staging, GitHub pull requests, an integrated terminal and a coding agent.",
  "keywords": [
    "git",
    "git-client",
    "gui",
    "electron",
    "github",
    "pull-requests",
    "commit-graph",
    "ai-agent"
  ],
  "homepage": "https://github.com/alouini333/gitlane",
  "bugs": {
    "url": "https://github.com/alouini333/gitlane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alouini333/gitlane.git"
  },
  "license": "MIT",
  "author": {
    "name": "Gitlane contributors",
    "email": "alouini333@users.noreply.github.com",
    "url": "https://github.com/alouini333/gitlane"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "postinstall": "node -e \"for (const a of ['darwin-arm64','darwin-x64']) { try { require('fs').chmodSync('node_modules/node-pty/prebuilds/'+a+'/spawn-helper', 0o755) } catch {} }\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.5.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron-winstaller": false,
    "fsevents@2.3.3": true
  },
  "build": {
    "appId": "dev.gitlane.app",
    "productName": "Gitlane",
    "copyright": "Copyright \u00a9 2026 Gitlane contributors",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Gitlane"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "synopsis": "Git client with a commit graph, pull requests and a coding agent",
      "maintainer": "Gitlane contributors <alouini333@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "${productName}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-linux-amd64.${ext}"
    },
    "publish": null
  }
}
